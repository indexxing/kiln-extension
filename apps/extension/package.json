{
	"name": "@kiln/extension",
	"description": "Polytoria QOL browser extension",
	"license": "GPL-3.0-only",
	"version": "2.13.2",
	"type": "module",
	"scripts": {
		"predev": "bun scripts/gen-feature-ids.ts && bun scripts/gen-feature-paths.ts",
		"dev": "wxt --port 3001",
		"dev:zen": "wxt -b firefox",
		"prebuild": "bun scripts/gen-feature-ids.ts && bun scripts/gen-feature-paths.ts",
		"build": "wxt build",
		"build:firefox": "wxt build -b firefox",
		"zip": "wxt zip",
		"zip:firefox": "wxt zip -b firefox",
		"compile": "tsc --noEmit",
		"postinstall": "wxt prepare && bun scripts/gen-feature-ids.ts && bun scripts/gen-feature-paths.ts",
		"get-commits": "bun scripts/get-commits.ts",
		"release": "bun scripts/release.ts",
		"deploy:extension": "bun scripts/deploy-mirror.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.10",
		"@types/three": "^0.183.1",
		"typescript": "^6.0.2",
		"wxt": "^0.19"
	},
	"dependencies": {
		"@kiln/schemas": "workspace:*",
		"@types/bun": "^1.3.13",
		"@webext-core/messaging": "^2.3.0",
		"three": "^0.183.2",
		"webext-storage": "^2.0.1",
		"zod": "^4.3.6"
	}
}
